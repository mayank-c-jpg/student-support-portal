<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
  <%- include('partials/navbar') %>

  <main class="flex-grow-1">
    <div class="container py-4">

      <!-- Welcome banner -->
      <div class="welcome-banner rounded-4 p-4 mb-4 text-white">
        <h2 class="fw-bold mb-1">Welcome back, <%= currentUser.name || currentUser.email %>! 👋</h2>
        <p class="mb-0 text-white-75">
          Ask the AI assistant anything about admissions, courses, fees, placements, and more.
        </p>
        <div class="mt-2">
          <% if (selectedCollege) { %>
            <span class="badge bg-light text-dark px-3 py-2 rounded-pill">
              <i class="bi bi-bank me-1"></i>Asking about: <strong><%= selectedCollege.name %></strong>
            </span>
            <a href="/colleges" class="small text-white ms-2">Change college</a>
          <% } else { %>
            <a href="/colleges" class="badge bg-warning text-dark px-3 py-2 rounded-pill text-decoration-none">
              <i class="bi bi-exclamation-circle me-1"></i>No college selected — pick one for tailored answers
            </a>
          <% } %>
        </div>
      </div>

      <div class="row g-4">
        <!-- Chatbot Panel -->
        <div class="col-lg-8">
          <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white rounded-top-4 d-flex align-items-center justify-content-between">
              <span class="fw-bold"><i class="bi bi-robot text-primary me-2"></i>AI Assistant</span>
              <span class="badge bg-success-subtle text-success" id="chatStatusBadge">
                <i class="bi bi-circle-fill me-1"></i>Online
              </span>
            </div>
            <div class="card-body p-0">
              <div id="chatWindow" class="chat-window p-3">
                <div class="chat-bubble bot">
                  Hello! I'm your campus AI assistant. Ask me about admissions,
                  courses, fee structure, placements, internships, exams,
                  scholarships, library services, or campus facilities.
                </div>
              </div>
            </div>
            <div class="card-footer bg-white rounded-bottom-4">
              <form id="chatForm" class="d-flex gap-2" autocomplete="off">
                <input
                  type="text"
                  id="chatInput"
                  class="form-control"
                  placeholder="Type your question..."
                  maxlength="1000"
                  required
                />
                <button type="submit" class="btn btn-primary" id="chatSendBtn">
                  <i class="bi bi-send-fill"></i>
                </button>
              </form>
              <div class="quick-topics mt-2 d-flex flex-wrap gap-2">
                <% ['Admissions','Fee structure','Placements','Scholarships','Library hours'].forEach(topic => { %>
                  <button type="button" class="btn btn-sm btn-outline-secondary quick-topic-btn"><%= topic %></button>
                <% }) %>
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar: Profile + Recent Chats -->
        <div class="col-lg-4">
          <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-body text-center">
              <div class="avatar-circle mx-auto mb-3">
                <%= (currentUser.name || currentUser.email || '?').charAt(0).toUpperCase() %>
              </div>
              <h5 class="fw-bold mb-0"><%= currentUser.name || 'Student' %></h5>
              <p class="text-muted small mb-2"><%= currentUser.email %></p>
              <span class="badge bg-primary-subtle text-primary text-capitalize"><%= currentUser.role %></span>
              <hr />
              <a href="/profile" class="btn btn-sm btn-outline-primary w-100">
                <i class="bi bi-person-gear me-1"></i>View / Edit Profile
              </a>
            </div>
          </div>

          <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white rounded-top-4 fw-bold">
              <i class="bi bi-clock-history text-primary me-2"></i>Recent Chat History
            </div>
            <div class="card-body p-0">
              <ul class="list-group list-group-flush" id="recentHistoryList">
                <% if (recentChats.length === 0) { %>
                  <li class="list-group-item text-muted small">No chat history yet. Start a conversation!</li>
                <% } %>
                <% recentChats.forEach(chat => { %>
                  <li class="list-group-item">
                    <div class="small text-muted"><%= new Date(chat.createdAt).toLocaleString() %></div>
                    <div class="fw-semibold text-truncate"><i class="bi bi-person-fill me-1"></i><%= chat.userMessage %></div>
                    <div class="text-truncate text-primary"><i class="bi bi-robot me-1"></i><%= chat.botReply %></div>
                  </li>
                <% }) %>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="card shadow-sm border-0 rounded-4 mt-4">
        <div class="card-header bg-white rounded-top-4 fw-bold">
          <i class="bi bi-question-circle text-primary me-2"></i>Frequently Asked Questions
        </div>
        <div class="card-body">
          <div class="accordion" id="faqAccordion">
            <% faqs.forEach((faq, idx) => { %>
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq<%= idx %>">
                    <span class="badge bg-secondary-subtle text-secondary me-2"><%= faq.category %></span>
                    <%= faq.question %>
                  </button>
                </h2>
                <div id="faq<%= idx %>" class="accordion-collapse collapse">
                  <div class="accordion-body text-muted"><%= faq.answer %></div>
                </div>
              </div>
            <% }) %>
            <% if (faqs.length === 0) { %>
              <p class="text-muted mb-0">No FAQs published yet.</p>
            <% } %>
          </div>
        </div>
      </div>

    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/chat.js"></script>
  <script src="/js/dashboard.js"></script>
</body>
</html>
