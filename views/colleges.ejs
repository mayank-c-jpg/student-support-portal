<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
  <%- include('partials/navbar') %>

  <main class="flex-grow-1">
    <div class="container py-4">
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
          <h2 class="fw-bold mb-1"><i class="bi bi-bank text-primary me-2"></i>Browse Colleges</h2>
          <p class="text-muted mb-0">Pick a college to get answers tailored to it in your AI assistant.</p>
        </div>
        <a href="/dashboard" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
        </a>
      </div>

      <div class="mb-4">
        <input
          type="text"
          id="collegeSearchInput"
          class="form-control form-control-lg"
          placeholder="Search by college name or location..."
        />
      </div>

      <div id="collegesGrid" class="row g-4">
        <% if (colleges.length === 0) { %>
          <div class="col-12">
            <div class="alert alert-info mb-0">
              No colleges have been added yet. Please check back later.
            </div>
          </div>
        <% } %>
        <% colleges.forEach(college => { %>
          <div class="col-md-6 col-lg-4 college-card"
               data-name="<%= college.name.toLowerCase() %>"
               data-location="<%= (college.location || '').toLowerCase() %>">
            <div class="card shadow-sm border-0 rounded-4 h-100">
              <div class="card-body d-flex flex-column">
                <h5 class="fw-bold mb-1"><%= college.name %></h5>
                <p class="text-muted small mb-2">
                  <i class="bi bi-geo-alt me-1"></i><%= college.location || 'Location not specified' %>
                </p>
                <p class="text-muted small mb-3 flex-grow-1">
                  <%= (college.description || 'No description available.').slice(0, 140) %><%= (college.description || '').length > 140 ? '…' : '' %>
                </p>
                <p class="small mb-3">
                  <i class="bi bi-mortarboard me-1"></i>
                  <%= (college.courses || []).length %> course<%= (college.courses || []).length === 1 ? '' : 's' %> offered
                </p>
                <button
                  type="button"
                  class="btn <%= selectedCollegeId === String(college._id) ? 'btn-success' : 'btn-primary' %> w-100 select-college-btn"
                  data-id="<%= college._id %>"
                  data-name="<%= college.name %>"
                >
                  <% if (selectedCollegeId === String(college._id)) { %>
                    <i class="bi bi-check-circle me-1"></i>Selected
                  <% } else { %>
                    Select This College
                  <% } %>
                </button>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <p id="noResultsMessage" class="text-muted text-center mt-4 d-none">
        No colleges match your search.
      </p>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/colleges.js"></script>
</body>
</html>
