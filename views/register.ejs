<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('partials/navbar') %>

  <main class="flex-grow-1 d-flex align-items-center auth-page">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
          <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
              <div class="text-center mb-4">
                <i class="bi bi-person-plus-fill fs-1 text-primary"></i>
                <h3 class="fw-bold mt-2">Create Your Account</h3>
                <p class="text-muted">Registration is handled securely by IBM Cloud App ID</p>
              </div>

              <ul class="small text-muted mb-4">
                <li>Your password is never stored on our servers.</li>
                <li>App ID's Cloud Directory manages verification &amp; password policies.</li>
                <li>You'll be redirected back here automatically after sign-up.</li>
              </ul>

              <a href="/auth/register" class="btn btn-primary w-100 py-2 fw-semibold">
                <i class="bi bi-person-plus me-2"></i>Continue to Secure Sign Up
              </a>

              <div class="text-center mt-4">
                <span class="text-muted small">Already have an account?</span>
                <a href="/login" class="small fw-semibold">Log in</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
