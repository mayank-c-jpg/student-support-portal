<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
</head>

<body class="d-flex flex-column min-vh-100">
    <%- include('partials/navbar') %>

        <main class="flex-grow-1">
            <section class="hero-section text-white">
                <div class="container py-5">
                    <div class="row align-items-center g-5">
                        <div class="col-lg-7">
                            <span class="badge bg-light text-dark mb-3 px-3 py-2 rounded-pill">
              <i class="bi bi-shield-lock-fill me-1"></i> Secured by IBM Cloud App ID
            </span>
                            <h1 class="display-5 fw-bold mb-3">
                                Your AI-Powered Student Support Portal
                            </h1>
                            <p class="lead mb-4 text-white-75">
                                Get instant answers about admissions, courses, fees, placements, internships, exams, scholarships, library services, and campus facilities — anytime, day or night — from our IBM Watson Assistant-powered chatbot.

                                <div class="d-flex gap-3">
                                    <a href="/auth/register" class="btn btn-light btn-lg px-4">Get Started</a>
                                    <a href="/auth/login" class="btn btn-outline-light btn-lg px-4">Login</a>
                                </div>
                            </p>
                        </div>
                        <div class="col-lg-5">
                            <div class="card shadow-lg border-0 chat-preview-card">
                                <div class="card-body">
                                    <div class="d-flex align-items-center mb-3">
                                        <i class="bi bi-robot fs-3 text-primary me-2"></i>
                                        <strong>Campus AI Assistant</strong>
                                    </div>
                                    <div class="chat-bubble bot">Hi! Ask me anything about admissions, fees, or placements.</div>
                                    <div class="chat-bubble user">What is the fee structure for B.Tech CSE?</div>
                                    <div class="chat-bubble bot">Here's a breakdown of tuition, hostel, and exam fees...</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="py-5">
                <div class="container">
                    <h2 class="text-center fw-bold mb-4">Everything You Need, In One Portal</h2>
                    <div class="row g-4">
                        <% const features = [
            ['bi-mortarboard', 'Admissions & Courses', 'Explore programs and eligibility instantly.'],
            ['bi-cash-coin', 'Fee Structure', 'Transparent, up-to-date fee information.'],
            ['bi-briefcase', 'Placements & Internships', 'Track opportunities and requirements.'],
            ['bi-calendar-check', 'Exam Schedules', 'Never miss an important exam date.'],
            ['bi-award', 'Scholarships', 'Find scholarships you qualify for.'],
            ['bi-book', 'Library & Campus', 'Services, hours, and facility info.'],
          ]; %>
                            <% features.forEach(([icon, title, desc]) => { %>
                                <div class="col-md-4">
                                    <div class="feature-card p-4 h-100 rounded-4 shadow-sm">
                                        <i class="bi <%= icon %> fs-2 text-primary mb-3"></i>
                                        <h5 class="fw-bold">
                                            <%= title %>
                                        </h5>
                                        <p class="text-muted mb-0">
                                            <%= desc %>
                                        </p>
                                    </div>
                                </div>
                                <% }) %>
                    </div>
                </div>
            </section>
        </main>

        <%- include('partials/footer') %>
</body>

</html>